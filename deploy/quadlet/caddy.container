[Unit]
Description=Cloud Image Storage Public HTTPS Portal
After=app.service network-online.target
Wants=app.service network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=cis-caddy
Network=cis.network
PublishPort=80:80
PublishPort=443:443
Volume=/etc/cis/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/srv/cis/caddy/data:/data:Z
Volume=/srv/cis/caddy/config:/config:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
