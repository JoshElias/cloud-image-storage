#!/usr/bin/env bash
set -euo pipefail

set -a
source /etc/cis/postgres.env
set +a

backup_key="db-backups/$(date -u +%Y%m%dT%H%M%SZ).sql"
backup_file="$(mktemp)"
trap 'rm -f "$backup_file"' EXIT

podman run \
  --rm \
  --log-driver=none \
  --network cis \
  --env-file /etc/cis/postgres.env \
  docker.io/library/postgres:17-alpine \
  pg_dump "$DATABASE_URL" > "$backup_file"

aws s3 cp --no-progress "$backup_file" "s3://${CIS_BUCKET}/${backup_key}"

echo "uploaded s3://${CIS_BUCKET}/${backup_key}"
